## Паттерны (для справки)

### Вызов API из JS
```javascript
async function loadManagers() {
  const res = await fetch("/api/v1/managers", {
    method: "GET",
    credentials: "include"
  });
  if (!res.ok) throw new Error("Не удалось загрузить менеджеров");
  return await res.json();
}
```

### Обработка submit формы
```javascript
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  statusEl.textContent = "Отправка...";
  try {
    const payload = { text: textInput.value.trim() };
    const res = await fetch("/api/v1/commercial/parse", {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error("Ошибка при обработке");
    const data = await res.json();
    statusEl.textContent = "Готово";
    renderResult(data);
  } catch (err) {
    statusEl.textContent = err.message;
  }
});
```
