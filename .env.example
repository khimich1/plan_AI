# Обязательно: минимум 32 символа, не использовать значения по умолчанию из репозитория.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# APP_ENV=production blocks kp_db clear_all_* unless both flags are set:
# ALLOW_DESTRUCTIVE_DB_RESET=1
# DESTRUCTIVE_DB_RESET_BREAK_GLASS=1
# Agent NDJSON in kp_db move_plates (off in production by default):
# APP_DEBUG=true
# KP_DB_AGENT_DEBUG=1

# Secure cookie за HTTPS (в production включается автоматически, если не задано явно).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# SESSION_COOKIE_MAX_AGE=43200

# Через запятую или JSON-массив (см. app.core.settings._split_cors_origins).
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR по фото: один вызов GPT-4o (OCR_VERIFY_ENABLED больше не используется).
# Внешнее распознавание изображений выключено по умолчанию (P6 WP7).
OCR_EXTERNAL_ENABLED=false
OCR_VERIFY_ENABLED=false
OPENAI_API_KEY=

# Rate limiting: счётчики в памяти процесса — до P7 (Redis) используйте один воркер.
# UVICORN_WORKERS=1
# WEB_CONCURRENCY=1
# APP_WORKERS=1
# RATE_LIMIT_SHARED_STORE=redis  # не реализовано (P7) — не задавать

# Telegram bot: allowlist telegram_id:role (admin | manager | production), comma-separated.
# Example: 123456789:admin,987654321:manager
# JSON alternative: [{"id": 123456789, "role": "admin"}]
# Required in production when BOT_AUTH_ENABLED=true (default).
BOT_AUTH_ENABLED=true
BOT_TELEGRAM_ALLOWLIST=
# BOT_AUTH_FAIL_CLOSED=true

# JSON seed for scripts/init_managers.py (default: data/managers_seed.json).
# Copy data/managers_seed.example.json and fill with real contacts locally; do not commit PII.
# MANAGERS_SEED_PATH=data/managers_seed.json
